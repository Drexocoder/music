# MongoDB persistence
MONGODB_URI=
# Use an existing collection when the Atlas cluster has no collection slots.
MONGODB_COLLECTION=aurora_records
# Optional when the URI does not include a database name.
MONGODB_DB_NAME=

# Telegram Bot API (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional. If omitted, the app derives a stable secret from the bot token.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_PASSCODE=

# YouTube authentication for the Vercel yt-dlp container.
# Store the complete Netscape cookies.txt file as one base64 secret.
YOUTUBE_COOKIES_B64=
# Local-development-only alternative: raw Netscape cookies.txt contents.
YOUTUBE_COOKIES=

# Optional YouTube API fallback
YOUTUBE_API_KEY=

# Public origin used by the bot to reach the Vercel downloader rewrite.
PUBLIC_APP_URL=

# Optional upstream service used for audio/video file downloads
DOWNLOAD_API_URL=
# Keep true for the Replit sidecar; set false on Vercel.
DOWNLOAD_LOCAL_ENABLED=true
DOWNLOAD_API_KEY=