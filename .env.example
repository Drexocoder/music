# MongoDB persistence
MONGODB_URI=
# Use an existing collection when the Atlas cluster has no collection slots.
MONGODB_COLLECTION=aurora_records
# Optional when the URI does not include a database name.
MONGODB_DB_NAME=

# Telegram Bot API (create a bot with @BotFather)
TELEGRAM_BOT_TOKEN=
# Optional. If omitted, the app derives a stable secret from the bot token.
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ADMIN_PASSCODE=

# Optional YouTube API fallback
YOUTUBE_API_KEY=

# Optional upstream service used for audio/video file downloads
DOWNLOAD_API_URL=
DOWNLOAD_API_KEY=