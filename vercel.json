{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "services": {
    "frontend": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "installCommand": "npm install --registry=https://registry.npmjs.org/"
    },

    "downloader": {
      "root": "api/",
      "runtime": "container",
      "entrypoint": "Dockerfile.vercel"
    }
  },

  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "downloader",
        "path": "/health"
      }
    },
    {
      "source": "/api/download/:path*",
      "destination": {
        "service": "downloader"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
